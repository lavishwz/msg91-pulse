{
  "name": "msg91-pulse",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start -p ${PORT:-3100}",
    "lint": "next lint",
    "db:check": "node scripts/db-check.mjs",
    "test:guard": "node --experimental-strip-types tests/sqlguard.test.mjs",
    "test": "npm run test:guard && npm run test:gtwy && npm run test:allowlist && npm run test:drafts && npm run test:members",
    "test:gtwy": "node --experimental-strip-types tests/gtwy.test.mjs",
    "test:allowlist": "node --experimental-strip-types tests/allowlist.test.mjs",
    "db:local": "bash scripts/local-db/up.sh",
    "db:local:stop": "bash scripts/local-db/up.sh stop",
    "db:local:reset": "bash scripts/local-db/up.sh reset",
    "db:local:seed": "node scripts/local-db/seed.mjs",
    "store:up": "bash scripts/pulse-store/up.sh",
    "store:reset": "bash scripts/pulse-store/up.sh reset",
    "test:drafts": "node --experimental-strip-types tests/drafts.test.mjs",
    "store:migrate": "curl -s -X POST \"http://127.0.0.1:3100/api/pulse/store/migrate?secret=$(grep ^AUTOPILOT_TICK_SECRET= .env.local | cut -d= -f2-)\"",
    "test:members": "node --experimental-strip-types tests/members.test.mjs"
  },
  "dependencies": {
    "jose": "^6.2.12",
    "mysql2": "^3.24.3",
    "next": "15.5.4",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "22.15.3",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "typescript": "5.8.3"
  }
}
