# MySQL connection for MSG91 Pulse
# Copy to .env.local and fill in real values. .env.local is git-ignored.

MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=

# Optional
# MYSQL_SSL=false          # set true if the server requires TLS
# MYSQL_POOL_LIMIT=10      # max pooled connections

# ── Ask: free-text questions, via GTWY ──────────────────────────────────────
# All AI calls go through GTWY (MSG91's own AI gateway) — no model provider is
# called directly. Optional: without a pauthkey the eight built-in Ask questions
# still work and a typed question returns a 501 saying what is missing.
GTWY_PAUTHKEY=

# The GTWY agent that answers Pulse's questions. Defaults to the one below.
# GTWY_AGENT_ID=6a9ebec00869a6b2a232c53f
# GTWY_BASE_URL=https://api.gtwy.ai

# Which MSG91 admin Pulse acts as (an ms_user.user_pid with user_type = 1).
# Defaults to the rep with the largest book.
# PULSE_ME_USER_PID=

# ── Who may sign in (docs/auth.md) ──────────────────────────────────────────
# Pulse is invite-only. Identity comes from MSG91's Proxy (routes.msg91.com):
# the widget on /login proves who somebody is, and the pulse_member table
# decides whether that person is allowed in.

# The registered app id for Pulse on Proxy. Public by design — the login widget
# renders itself into an element with this id.
NEXT_PUBLIC_REFERENCEID=1258584i17889575326aa1535c30048

# Signs Pulse's own session cookie. Any long random string; changing it signs
# everybody out. Generate one with: openssl rand -base64 48
JWT_SECRET=<a long random string>

# Proxy's root. Only change this to point at a staging proxy.
# PROXY_BASE_URL=https://routes.msg91.com/api

# Optional. With it, Pulse looks users up with Proxy's admin API — the exact
# path the ViaSocket admin panel takes, and the one that can prefill an
# invitee's name. Without it, login falls back to asking Proxy about the
# visitor with the visitor's own token, which needs no key.
# PROXY_ADMIN_TOKEN=<proxy app authkey>
